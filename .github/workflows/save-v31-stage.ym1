name: Save NFL Picker V3.1 Stage

on:
  workflow_dispatch:
    inputs:
      season:
        description: "NFL season"
        required: true
        default: "2026"
      week:
        description: "NFL week"
        required: true
        default: "1"
      stage:
        description: "Pick stage"
        required: true
        type: choice
        options:
          - EARLY
          - UPDATED
          - FINAL

permissions:
  contents: write

jobs:
  snapshot:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      - run: |
          python run_pick_snapshot.py --season "${{ inputs.season }}" --week "${{ inputs.week }}" --stage "${{ inputs.stage }}"
      - run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add outputs/pick_history/
          git diff --cached --quiet && exit 0
          git commit -m "Save V3.1 ${{ inputs.stage }} picks - ${{ inputs.season }} Week ${{ inputs.week }}"
          git pull --rebase origin main
          git push origin main
